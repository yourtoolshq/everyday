{
  "name": "taxbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "sh scripts/backup.sh",
    "build": "SKIP_ENV_VALIDATION=1 DATABASE_URL=file:/tmp/taxbook-build.db next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm db:migrate && next dev --turbo --port ${PORT:-3000}",
    "lint": "eslint .",
    "preview": "next build && next start",
    "restore": "sh scripts/restore.sh",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.43.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "sonner": "^2.0.8",
    "superjson": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
