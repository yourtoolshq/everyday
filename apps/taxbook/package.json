{
  "name": "taxbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SKIP_ENV_VALIDATION=1 DATA_DIR=/tmp/taxbook-build-data next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "data": "pnpm --silent -F @yourtoolshq/data build && node node_modules/@yourtoolshq/data/dist/yt-data.cjs --app taxbook --migrations drizzle --data-dir \"${DATA_DIR:-./.data}\" --url \"http://127.0.0.1:${PORT:-3000}\"",
    "dev": "next dev --turbo --port ${PORT:-3000}",
    "lint": "eslint .",
    "preview": "next build && next start",
    "migrations:check": "pnpm data migrations check",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/tax-book.spec.ts && playwright test e2e/filing.spec.ts --grep 'backfills' && playwright test e2e/filing.spec.ts --grep 'confirms lifecycle'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "@yourtoolshq/data": "workspace:*",
    "@yourtoolshq/data-ui": "workspace:*",
    "@yourtoolshq/server": "workspace:*",
    "@yourtoolshq/ui": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.43.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "sonner": "^2.0.8",
    "superjson": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@yourtoolshq/eslint-config": "workspace:*",
    "@yourtoolshq/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
