{
  "extends": "@yourtoolshq/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "~/trpc/react": ["./src/trpc/react.tsx"],
      "~/*": ["../shared/*"],
      "next/image": ["./src/shims/image.tsx"],
      "next/link": ["./src/shims/link.tsx"],
      "next/navigation": ["./src/shims/navigation.ts"],
      "next/headers": ["./src/shims/headers.ts"],
      "server-only": ["./src/shims/server-only.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
