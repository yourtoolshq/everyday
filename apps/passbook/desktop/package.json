{
  "name": "@passbook/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "build": {
    "extends": null,
    "appId": "com.yourtoolshq.passbook",
    "productName": "Passbook",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../host/dist",
        "to": "host",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../drizzle",
        "to": "passbook/drizzle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "passbook-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Passbook-${version}-${arch}.${ext}"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:client": "pnpm --filter @passbook/client build",
    "build:host": "pnpm --filter @passbook/host build",
    "dev": "pnpm build && node --import tsx scripts/dev.ts",
    "verify:electron": "node --import tsx -e \"import { assertElectronInstalled } from './electron/verify-install.ts'; assertElectronInstalled(); console.log('Electron install OK');\"",
    "lint": "eslint .",
    "package:linux": "pnpm build:client && pnpm build:host && pnpm build && electron-builder --linux --publish never",
    "package:mac": "pnpm build:client && pnpm build:host && pnpm build && electron-builder --mac --arm64 --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtoolshq/eslint-config": "workspace:*",
    "@yourtoolshq/tsconfig": "workspace:*",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
