{
  "extends": "@yourtoolshq/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./shared/*"]
    }
  },
  "include": [
    "shared/lib/**/*.ts",
    "shared/server/**/*.ts",
    "shared/modules/**/*.ts",
    "shared/core/**/*.ts",
    "shared/env.js",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.foundation.config.ts"
  ],
  "exclude": [
    "node_modules",
    "generated",
    "shared/components/**",
    "host/**",
    "client/**",
    "desktop/**",
    "fixtures/**",
    "scripts/**",
    "e2e/**"
  ]
}
