{
  "name": "passbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack --port ${PORT:-3002}",
    "docker:build": "docker build -f Dockerfile -t passbook ../..",
    "docker:up": "docker compose up --build",
    "lint": "eslint .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "backup": "sh scripts/backup.sh",
    "restore": "sh scripts/restore.sh"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "@yourtoolshq/data": "workspace:*",
    "@yourtoolshq/data-ui": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "^0.468.0",
    "next": "catalog:",
    "postal-mime": "^3.0.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "sonner": "^2.0.7",
    "superjson": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
