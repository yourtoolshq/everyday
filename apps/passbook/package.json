{
  "name": "passbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "data": "pnpm --silent -F @yourtoolshq/data build && node node_modules/@yourtoolshq/data/dist/yt-data.cjs --app passbook --migrations drizzle --data-dir \"${DATA_DIR:-./.data}\" --url \"http://127.0.0.1:${PASSBOOK_HOST_PORT:-3847}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "migrations:check": "pnpm data migrations check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "foundation:gate": "pnpm --silent -F @yourtoolshq/data build && node scripts/foundation-gate.mjs && playwright test --config playwright.foundation.config.ts",
    "remote-access:gate": "node scripts/remote-access-gate.mjs",
    "release:gate": "pnpm --silent -F @yourtoolshq/data build && node scripts/release-gate.mjs",
    "migration-rehearsal:gate": "pnpm --silent -F @yourtoolshq/data build && node scripts/migration-rehearsal-gate.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "@yourtoolshq/data": "workspace:*",
    "@yourtoolshq/data-ui": "workspace:*",
    "@yourtoolshq/server": "workspace:*",
    "@yourtoolshq/ui": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "catalog:",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "sonner": "^2.0.7",
    "superjson": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@yourtoolshq/eslint-config": "workspace:*",
    "@yourtoolshq/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "next": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
