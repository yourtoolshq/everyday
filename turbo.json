{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^topo"],
      "outputs": ["coverage/**"]
    },
    "migrations:check": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^topo"]
    },
    "foundation:gate": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DEV",
    "NODE_ENV",
    "VITE_PASSBOOK_ALLOW_REMOTE",
    "VITE_PASSBOOK_HOST_URL",
    "CI",
    "PORT",
    "DATABASE_URL",
    "APP_VERSION",
    "BACKUP_DIR",
    "DATA_DIR",
    "HOST",
    "PASSBOOK_CLIENT_DEV_URL",
    "PASSBOOK_DESKTOP_USE_DIST",
    "PASSBOOK_HOST_URL",
    "PASSBOOK_LEAVE_HOST_RUNNING",
    "DOCUMENTS_DIR",
    "SKIP_ENV_VALIDATION",
    "TAXBOOK_PORT",
    "FIRSTAID_PORT",
    "PASSBOOK_PORT",
    "TENURE_PORT"
  ]
}
