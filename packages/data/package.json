{
  "name": "@yourtoolshq/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./files": "./src/files/index.ts",
    "./next": "./src/next/handlers.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "build": "esbuild src/cli/index.ts --bundle --platform=node --target=node22 --format=cjs --external:@libsql/client --outfile=dist/yt-data.cjs --log-level=warning",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@libsql/client": "catalog:",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/node": "catalog:",
    "@yourtoolshq/eslint-config": "workspace:*",
    "@yourtoolshq/prettier-config": "workspace:*",
    "@yourtoolshq/tsconfig": "workspace:*",
    "drizzle-orm": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "prettier": "@yourtoolshq/prettier-config",
  "dependencies": {
    "tar-stream": "^3.2.1"
  }
}
